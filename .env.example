# Optional application secrets: fill securely in a private .env, never commit values.
# The HTTP backend requires a strong raw bearer token. Proxy credential placeholders
# are unsuitable as server-side bearer secrets; use a local secret manager or .env.
EW_API_TOKEN=
EW_LLM_API_KEY=
# Non-secret provider overrides, if required:
# EW_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EW_LLM_MODEL=llama3.2
